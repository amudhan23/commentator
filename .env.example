# Copy this file to ".env" and fill in your keys.
# Nothing here is committed (see .gitignore).

# Gemini — the agent's brain (vision + commentary + Q&A).
# FREE key at https://aistudio.google.com  → "Get API key". No card needed.
GEMINI_API_KEY=

# Optional: pick the Gemini model. Default is gemini-flash-latest (auto-updating
# stable flash). Run `npm run try` to see which ids work for your key.
# GEMINI_MODEL=gemini-flash-latest

# Optional: broadcast-quality voice. Leave unset to use the free browser voice.
# https://elevenlabs.io → Profile → API key.  List your voices: `npm run voices`
ELEVENLABS_API_KEY=

# Optional: a default Voice ID (run `npm run voices` to see yours). Each
# commentator can also carry its own voice (set in the Commentators tab).
ELEVENLABS_VOICE_ID=

# Optional: the ElevenLabs model. Default is eleven_multilingual_v2 so Indian
# languages (Tamil, Hindi, Telugu…) render — the whole point. Override if needed.
# ELEVENLABS_MODEL=eleven_multilingual_v2
